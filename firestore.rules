rules_version = '2';
// Reglas de seguridad de ZendoApp.
// Cambiá merdugan99@gmail.com por tu email de profe (el mismo de config.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'merdugan99@gmail.com';
    }
    function signedIn() { return request.auth != null; }

    // Ajustes del gimnasio (cupo, turnos, precios, alertas)
    match /meta/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Alumnos, asistencias: los alumnos leen (para su ficha y el ranking), sólo el profe escribe
    match /students/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /sessions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Turnos: el alumno sólo puede crear solicitudes pendientes; confirmar o borrar es del profe
    match /res/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.status == 'pend');
      allow update, delete: if isAdmin();
    }
    // Celulares que reciben avisos: cada uno registra el suyo; sólo el profe los lee o borra
    match /tokens/{t} {
      allow create, update: if signedIn();
      allow read, delete: if isAdmin();
    }
    // Control interno de avisos enviados (sólo lo usa el servidor)
    match /notified/{x} {
      allow read, write: if false;
    }
    // Pagos: sólo el profe
    match /pays/{id} {
      allow read, write: if isAdmin();
    }
  }
}
